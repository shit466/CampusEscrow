# Public addresses only. Do not put wallet secret keys, seed phrases, or RPC tokens here.
# The Next.js app reads web/.env.local. Copy these values there.
# NEXT_PUBLIC_PROGRAM_ID is the Devnet program deployed from this workspace.
# A fresh local-validator build still creates a different program keypair.
# Point the web app at the address below to read the Devnet deployment.
# After anchor keys sync for a new local program, use that new public key instead.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=13xMGTJyfEDXXkYjqvhej8gvQoSypSeMWUTSAQrM7CUE
