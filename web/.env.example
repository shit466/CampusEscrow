# Public Devnet configuration. No secrets belong in this file.
# Copy to web/.env.local before `npm run dev`.
# This program id is the deployed Devnet program.
# Use it to read Devnet. A new local validator keypair from anchor keys sync
# is a different address; put that public key here only for localnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=13xMGTJyfEDXXkYjqvhej8gvQoSypSeMWUTSAQrM7CUE
